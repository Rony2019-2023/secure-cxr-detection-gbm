        "\n",
        "# ============================================================\n",
        "# Initialize Random Forest Classifier\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "# Convert input data to NumPy arrays\n",
        "X_train_rf = np.asarray(X_train, dtype=np.float32)\n",
        "X_test_rf = np.asarray(X_test, dtype=np.float32)\n",
        "\n",
        "# Flatten image data if it has more than 2 dimensions\n",
        "if X_train_rf.ndim > 2:\n",
        "    X_train_rf = X_train_rf.reshape(\n",
        "        X_train_rf.shape[0], -1\n",
        "    )\n",
        "    X_test_rf = X_test_rf.reshape(\n",
        "        X_test_rf.shape[0], -1\n",
        "    )\n",
        "\n",
        "# Normalize pixel values if they are in the 0-255 range\n",
        "if X_train_rf.max() > 1.0:\n",
        "    X_train_rf /= 255.0\n",
        "    X_test_rf /= 255.0\n",
        "\n",
        "# Initialize Random Forest model\n",
        "model = RandomForestClassifier(\n",
        "    n_estimators=100,\n",
        "    max_depth=None,\n",
        "    class_weight=\"balanced\",\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# Measure Training Time\n",
        "# ============================================================\n",
        "\n",
        "start_time = time.perf_counter()\n",
        "\n",
        "model.fit(\n",
        "    X_train_rf,\n",
        "    np.asarray(y_train).ravel()\n",
        ")\n",
        "\n",
        "training_time = time.perf_counter() - start_time\n",
        "\n",
        "print(\n",
        "    f\"Training completed in {training_time:.2f} seconds\"\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# Measure Testing Time\n",
        "# ============================================================\n",
        "\n",
        "test_start_time = time.perf_counter()\n",
        "\n",
        "y_pred = model.predict(X_test_rf)\n",
        "y_prob = model.predict_proba(X_test_rf)[:, 1]\n",
        "\n",
        "testing_time = time.perf_counter() - test_start_time\n",
        "\n",
        "print(f\"Testing Time: {testing_time:.4f} seconds\")\n",
        "print(f\"Test images: {len(X_test_rf)}\")\n",
        "\n",
        "print(\n",
        "    \"Average prediction time per image:\",\n",
